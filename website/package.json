{
  "name": "@devcodex/lorebit-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev:user",
    "build": "npm run build:user",
    "preview": "npm run preview:user",
    "test": "npm run test:user",
    "dev:user": "rspress dev --config user-site/rspress.config.ts",
    "build:user": "rspress build --config user-site/rspress.config.ts",
    "preview:user": "npm run build:user && rspress preview --config user-site/rspress.config.ts",
    "test:user": "npm run build:user && node --test user-site/tests/docs-contract.test.mjs user-site/tests/public-release-contract.test.mjs",
    "dev:maintainer": "rspress dev --config ../../.devcodex/lorebit/maintainer-site/rspress.config.ts --host 127.0.0.1",
    "build:maintainer": "rspress build --config ../../.devcodex/lorebit/maintainer-site/rspress.config.ts",
    "preview:maintainer": "npm run build:maintainer && rspress preview --config ../../.devcodex/lorebit/maintainer-site/rspress.config.ts --host 127.0.0.1",
    "test:maintainer": "npm run build:maintainer && node --test ../../.devcodex/lorebit/maintainer-site/tests/site-contract.test.mjs ../../.devcodex/lorebit/maintainer-site/tests/rendered-site.test.mjs"
  },
  "devDependencies": {
    "@rspress/core": "2.0.10",
    "@types/node": "22.15.17",
    "typescript": "5.8.3"
  },
  "overrides": {
    "@unhead/react": "2.1.13",
    "unhead": "2.1.13",
    "@rsbuild/core": "2.0.3",
    "@rsbuild/plugin-react": "2.0.0",
    "@rspack/core": "2.0.1",
    "@rspack/binding": "2.0.1",
    "@rspack/plugin-react-refresh": "2.0.0"
  }
}
